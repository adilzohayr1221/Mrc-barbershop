{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/partners/layout,_N_T_/partners/page,_N_T_/partners"},"segmentPaths":["/_tree","/_full","/partners/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/1f10e12095be239f82bcf910c2af9a0834788ac5c1ccef743979c2a37bdcc055/$/partners","owner":{"kind":"APP_PAGE","sourceRoute":"/partners/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"inter_1961c67d-module__SrZceW__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, interactive-widget=resizes-content\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.2bn3s6zvc0dyp.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=256&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1mpe-wm7ad5ox.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3yfl9fgvivx3-.js\"/><script src=\"/_next/static/chunks/11jq0c2_zavac.js\" async=\"\"></script><script src=\"/_next/static/chunks/3g4px251sg85e.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h-uhh91ijkha.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-3qjqozjdi9_qe.js\" async=\"\"></script><script src=\"/_next/static/chunks/14d0lf00p3lgd.js\" async=\"\"></script><script src=\"/_next/static/chunks/43-qqhzm_q87b.js\" async=\"\"></script><script src=\"/_next/static/chunks/18e52yuhnp006.js\" async=\"\"></script><title>MRC Barbershop</title><meta name=\"description\" content=\"Book your cut at MRC Barbershop — Baltimore, MD\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-title\" content=\"MRC Barbershop\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"/><meta property=\"og:title\" content=\"MRC Barbershop\"/><meta property=\"og:description\" content=\"Book your cut at MRC Barbershop — Baltimore, MD\"/><meta property=\"og:url\" content=\"https://mrc-barbershop-mrc-0043.vercel.app\"/><meta property=\"og:site_name\" content=\"MRC Barbershop\"/><meta property=\"og:image\" content=\"https://mrc-barbershop-mrc-0043.vercel.app/logo.jpg\"/><meta property=\"og:image:width\" content=\"1284\"/><meta property=\"og:image:height\" content=\"1284\"/><meta property=\"og:image:alt\" content=\"MRC Barbershop\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"MRC Barbershop\"/><meta name=\"twitter:description\" content=\"Book your cut at MRC Barbershop — Baltimore, MD\"/><meta name=\"twitter:image\" content=\"https://mrc-barbershop-mrc-0043.vercel.app/logo.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icons/icon-192.png\"/><link rel=\"apple-touch-icon\" href=\"/icons/apple-touch-icon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-50 bg-[#faf6ea]/85 backdrop-blur-md border-b border-[#e6dabf]\"><div class=\"max-w-md mx-auto px-4 py-2.5 flex items-center gap-3\"><a class=\"flex items-center gap-2.5\" aria-label=\"MRC Barbershop home\" href=\"/\"><img alt=\"MRC Barbershop logo\" width=\"38\" height=\"38\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-full border-2 border-[#a8821f]/70 shadow-[0_0_14px_rgba(212,175,55,0.35)]\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=48&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75\"/><span class=\"font-extrabold tracking-tight text-[17px] leading-none\"><span class=\"gold-text\">MRC Barbershop</span></span></a></div></header><main class=\"flex-1 w-full\"><section class=\"px-6 pt-12 pb-10 text-center max-w-2xl mx-auto\"><div class=\"relative inline-block\"><img alt=\"MRC\" width=\"96\" height=\"96\" decoding=\"async\" data-nimg=\"1\" class=\"hero-logo mx-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogo.jpg&amp;w=96&amp;q=75 1x, /_next/image?url=%2Flogo.jpg&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Flogo.jpg&amp;w=256&amp;q=75\"/></div><p class=\"mt-6 text-[11px] font-bold tracking-[0.32em] uppercase text-gold\">For barbershop owners</p><h1 class=\"mt-3 text-[38px] leading-[1.1] font-extrabold tracking-tight text-[#141414]\">Your shop,<br/><span class=\"gold-text\">in every customer&#x27;s pocket.</span></h1><div class=\"ornament w-48 mt-5 mx-auto\"><span class=\"ornament-diamond\"></span></div><p class=\"mt-4 text-neutral-600 text-[15px] leading-relaxed max-w-md mx-auto\">The same booking system MRC Barbershop runs on — your own customer app, barber app and owner dashboard, with your name on it.</p><a href=\"#request\" class=\"gold-btn rounded-2xl px-8 py-4 text-[16px] font-extrabold inline-flex items-center gap-2 mt-7\">Get my own app <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"></line><polyline points=\"13 5 20 12 13 19\"></polyline></svg></a></section><section class=\"px-4 py-10 max-w-2xl mx-auto w-full\"><p class=\"text-[11px] font-bold tracking-[0.32em] uppercase text-gold text-center\">What you get</p><h2 class=\"text-[26px] font-extrabold tracking-tight text-[#141414] text-center mt-2\">Everything runs itself</h2><div class=\"grid gap-3 mt-7\"><div class=\"card p-5 flex items-start gap-4\"><span class=\"flex items-center justify-center w-11 h-11 rounded-full shrink-0 bg-gold/10 border border-gold/40 text-gold\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg></span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">Online booking that fills chairs</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Customers book their barber, day and time in seconds — with a card deposit so no-shows cost them, not you.</span></span></div><div class=\"card p-5 flex items-start gap-4\"><span class=\"flex items-center justify-center w-11 h-11 rounded-full shrink-0 bg-gold/10 border border-gold/40 text-gold\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg></span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">Reviews that build your name</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Every haircut ends with a star rating prompt. Great work turns into public proof, automatically.</span></span></div><div class=\"card p-5 flex items-start gap-4\"><span class=\"flex items-center justify-center w-11 h-11 rounded-full shrink-0 bg-gold/10 border border-gold/40 text-gold\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg></span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">A real owner dashboard</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Bookings, barbers, services, prices, reviews and earnings — your whole shop on one phone screen.</span></span></div><div class=\"card p-5 flex items-start gap-4\"><span class=\"flex items-center justify-center w-11 h-11 rounded-full shrink-0 bg-gold/10 border border-gold/40 text-gold\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><polyline points=\"12 7 12 12 15.5 13.5\"></polyline></svg></span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">Plans, gifts &amp; reminders</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Weekly membership plans, QR gift cards, and automatic appointment reminders keep customers coming back.</span></span></div></div></section><section class=\"px-4 py-10 max-w-2xl mx-auto w-full\"><div class=\"rounded-3xl p-7 text-white relative overflow-hidden\" style=\"background:linear-gradient(135deg, #2a2417 0%, #1c1a15 55%, #0f0e0c 100%)\"><div class=\"absolute -top-10 -right-10 w-40 h-40 rounded-full bg-gold/20 blur-2xl\"></div><p class=\"text-[11px] font-bold tracking-[0.32em] uppercase text-gold\">One system</p><h2 class=\"text-[24px] font-extrabold tracking-tight mt-2\">Three apps, working together</h2><div class=\"grid gap-4 mt-6\"><div class=\"flex gap-4 items-start\"><span class=\"w-8 h-8 rounded-full bg-gold text-[#1c1a15] font-extrabold text-[14px] flex items-center justify-center shrink-0\">1</span><span><span class=\"block font-extrabold text-[16px]\">Customer app</span><span class=\"block text-[14px] text-white/70 mt-1 leading-relaxed\">Find your shop on the map, pick a barber, book and pay the deposit. Installs on iPhone and Android.</span></span></div><div class=\"flex gap-4 items-start\"><span class=\"w-8 h-8 rounded-full bg-gold text-[#1c1a15] font-extrabold text-[14px] flex items-center justify-center shrink-0\">2</span><span><span class=\"block font-extrabold text-[16px]\">Barber app</span><span class=\"block text-[14px] text-white/70 mt-1 leading-relaxed\">Daily schedule, customer chat, instant payouts after every haircut, and earnings at a glance.</span></span></div><div class=\"flex gap-4 items-start\"><span class=\"w-8 h-8 rounded-full bg-gold text-[#1c1a15] font-extrabold text-[14px] flex items-center justify-center shrink-0\">3</span><span><span class=\"block font-extrabold text-[16px]\">Owner app</span><span class=\"block text-[14px] text-white/70 mt-1 leading-relaxed\">Approve barbers, set prices, read reviews, watch earnings grow — from anywhere.</span></span></div></div></div></section><section class=\"px-4 py-10 max-w-2xl mx-auto w-full\"><p class=\"text-[11px] font-bold tracking-[0.32em] uppercase text-gold text-center\">How it works</p><h2 class=\"text-[26px] font-extrabold tracking-tight text-[#141414] text-center mt-2\">Live in three steps</h2><div class=\"grid gap-3 mt-7\"><div class=\"card p-5 flex items-start gap-4\"><span class=\"w-10 h-10 rounded-2xl bg-[#1c1a15] text-gold font-extrabold text-[16px] flex items-center justify-center shrink-0\">1</span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">Request your setup</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Fill in the form below with your shop details. It takes less than a minute.</span></span></div><div class=\"card p-5 flex items-start gap-4\"><span class=\"w-10 h-10 rounded-2xl bg-[#1c1a15] text-gold font-extrabold text-[16px] flex items-center justify-center shrink-0\">2</span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">We build your app</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Your branding, your services, your prices — set up and ready for your barbers.</span></span></div><div class=\"card p-5 flex items-start gap-4\"><span class=\"w-10 h-10 rounded-2xl bg-[#1c1a15] text-gold font-extrabold text-[16px] flex items-center justify-center shrink-0\">3</span><span><span class=\"block font-extrabold text-[16px] text-[#141414]\">Invite your barbers</span><span class=\"block text-[14px] text-neutral-600 mt-1 leading-relaxed\">Your team joins, customers start booking, and you watch it all from your phone.</span></span></div></div></section><section id=\"request\" class=\"px-4 py-10 max-w-2xl mx-auto w-full scroll-mt-20\"><p class=\"text-[11px] font-bold tracking-[0.32em] uppercase text-gold text-center\">Request a setup</p><h2 class=\"text-[26px] font-extrabold tracking-tight text-[#141414] text-center mt-2 mb-6\">Tell us about your shop</h2><div class=\"card p-6\"><div class=\"grid gap-3.5\"><div><span class=\"label\">Your name *</span><input placeholder=\"e.g. Karim Haddad\" class=\"input\" maxLength=\"60\" value=\"\"/></div><div><span class=\"label\">Salon name *</span><input placeholder=\"e.g. Fade Factory\" class=\"input\" maxLength=\"80\" value=\"\"/></div><div class=\"grid grid-cols-2 gap-3\"><div><span class=\"label\">Phone *</span><input placeholder=\"(410) 555-0134\" inputMode=\"tel\" class=\"input\" maxLength=\"30\" value=\"\"/></div><div><span class=\"label\">City</span><input placeholder=\"Baltimore\" class=\"input\" maxLength=\"60\" value=\"\"/></div></div><div><span class=\"label\">Email</span><input placeholder=\"you@salon.com\" inputMode=\"email\" class=\"input\" maxLength=\"80\" value=\"\"/></div><button class=\"gold-btn rounded-2xl px-6 py-4 text-[16px] font-extrabold disabled:opacity-60 flex items-center justify-center gap-2\">Request my app <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"></line><polyline points=\"13 5 20 12 13 19\"></polyline></svg></button><p class=\"text-[12px] text-neutral-500 text-center leading-relaxed\">No commitment. We&#x27;ll call you, show you how it works, and talk pricing.</p></div></div><p class=\"text-center mt-8\"><a class=\"text-sm text-neutral-500 underline underline-offset-4\" href=\"/\">← Back to MRC Barbershop</a></p></section><footer class=\"px-6 py-8 text-center\"><p class=\"text-[12px] text-neutral-400 flex items-center justify-center gap-1.5\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" class=\"text-gold/60\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg> Powered by MRC Barbershop · Baltimore, MD</p></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3yfl9fgvivx3-.